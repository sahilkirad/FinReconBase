ENVIRONMENT=local
APP_NAME=Fintech Reconciliation Backend

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/finrecon

GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id

JWT_SECRET_KEY=replace-with-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15

KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_CA_LOCATION=/app/certs/ca.crt
KAFKA_SSL_CERTIFICATE_LOCATION=/app/certs/client.crt
KAFKA_SSL_KEY_LOCATION=/app/certs/client.key

GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Layer 1: Ingestion & Extraction
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

OCR_ENGINE=tesseract


MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png

BLUR_THRESHOLD=100.0
BLUR_SHARPEN_ENABLED=true

CLASSIFICATION_THRESHOLD=0.80

INVOICE_EXTRACTED_TOPIC=invoice.extracted.events
RECONCILIATION_COMPLETED_TOPIC=reconciliation.completed.events
RECONCILIATION_DLQ_TOPIC=reconciliation.dlq.events
